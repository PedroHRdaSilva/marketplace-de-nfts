# Data source: "mock" (MSW in the browser) or "api" (real backend).
VITE_DATA_SOURCE=mock

# Base URL used by Axios. Keep "/api" for same-origin/MSW; use the Render URL in API mode.
VITE_API_URL=/api

# Socket.IO server. Leave empty to use the current origin.
VITE_SOCKET_URL=

# Socket.IO path.
VITE_SOCKET_PATH=/socket.io

# Optional override. Defaults to true when VITE_DATA_SOURCE=mock.
VITE_ENABLE_MSW=true
